{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geronimo-iia/llm-wiki/schemas/v0.1.0/plan.json",
  "title": "Plan type",
  "description": "Project implementation plans",
  "type": "object",
  "required": ["title", "type", "status", "certified_for_ai", "created_at"],
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "plan"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "draft"]
    },
    "certified_for_ai": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "completed_at": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "archived_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "superseded_by": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "x-wiki-types": {
    "plan": "Project implementation plans"
  },
  "additionalProperties": true
}
