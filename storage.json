{
  "nas": {
    "hostname": "truenas",
    "ips": {
      "server_vlan": "10.10.10.50",
      "client_vlan": "10.10.10.50"
    },
    "local": {
      "postgres_disk": {
        "device": "/dev/sdb",
        "mountpoint": "/var/mnt/postgres",
        "description": "Dedicate Zvol for CloudNativePG",
        "size": "100Gi",
        "fs": "XFS (Formatted by Talos)",
        "provisioner": "rancher.io/local-path",
        "status": "OPERATIONAL",
        "notes": "Local storage is physically bound to the nodes. Active replication handled by CNPG across talos-cp-01, talos-cp-02, and talos-cp-03.",
        "nodes": [
          "talos-cp-01",
          "talos-cp-02",
          "talos-cp-03"
        ]
      }
    },
    "exports": {
      "k8s_arr": {
        "path": "/mnt/stripe/k8s-arr",
        "description": "Kubernetes PVCs for Arr stack (Config / SQLite)",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ]
      },
      "media": {
        "path": "/mnt/oliraid/arrdata/media",
        "description": "Mass Storage for Media Library",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ],
        "subdirs": [
          {
            "name": "downloads/radarr",
            "purpose": "qBittorrent category 'radarr' save path"
          },
          {
            "name": "downloads/lidarr",
            "purpose": "qBittorrent category 'lidarr' save path"
          },
          {
            "name": "downloads/readarr",
            "purpose": "qBittorrent category 'readarr' save path"
          },
          {
            "name": "downloads/classical",
            "purpose": "qBittorrent category 'classical' save path"
          }
        ]
      },
      "classical": {
        "path": "/mnt/oliraid/arrdata/classical",
        "description": "Mass Storage for Classical Music Library",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime",
          "resvport"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ]
      },
      "qbittorrent_temp": {
        "path": "/mnt/stripe/qb_temp",
        "description": "NVMe Optimized temporary storage for qBittorrent",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime",
          "resvport"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ],
        "zfs_recordsize": "16k",
        "zfs_sync": "disabled",
        "notes": "Optimized for IOPS burst. Force Async sync for high-speed download."
      },
      "backup_proxmox": {
        "path": "/mnt/oliraid/backup-proxmox",
        "description": "Legacy Proxmox VZDump Backups (Archive)",
        "protocol": "nfs",
        "networks": [
          "10.10.10.0/24"
        ]
      },
      "pbs_store": {
        "path": "/mnt/oliraid/pbs-store",
        "description": "Proxmox Backup Server Datastore (Chunk-based)",
        "protocol": "nfs",
        "networks": [
          "10.10.10.0/24"
        ]
      },
      "backup_k8s_arr": {
        "path": "/mnt/oliraid/backup-stripe",
        "description": "Replica Target for Stripe (ZFS Snapshots)",
        "protocol": "zfs-replication",
        "networks": []
      },
      "k8s_n8n": {
        "path": "/mnt/stripe/k8s-n8n",
        "description": "NFS PVCs for n8n stack (Config / Database / Workflows)",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100"
        ]
      },
      "games": {
        "path": "/mnt/stripe/games",
        "description": "NFS Share for Games / Steam Library in Proxmox",
        "protocol": "nfs",
        "mount_options": [
          "nfsvers=4.2",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime"
        ],
        "networks": [
          "*"
        ]
      },
      "garage_data": {
        "path": "/mnt/oliraid/garage-data",
        "description": "Dataset ZFS per Garage S3",
        "protocol": "hostpath/docker",
        "notes": "Mappato direttamente all'app Custom Garage su TrueNAS. Nessun overhead NFS.",
        "networks": []
      },
      "jellyfin_trickplay": {
        "path": "/mnt/oliraid/jellyfin-trickplay",
        "description": "Specialized ZFS Dataset for Jellyfin Trickplay (BIF) files",
        "protocol": "nfs",
        "zfs_compression": "zstd",
        "zfs_recordsize": "1M",
        "zfs_atime": "off",
        "zfs_quota": "500G",
        "notes": "Dedicated dataset excluded from ZFS snapshot backups and offsite replicas. High performance 1M recordsize for large BIF sequential files.",
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ]
      },
      "k8s_sn": {
        "path": "/mnt/oliraid/k8s-sn",
        "description": "NFS Storage per ServiceNow MID Server (Cache Workdir, Download & Logs)",
        "protocol": "nfs",
        "zfs_quota": "20G",
        "mount_options": [
          "nfsvers=4.1",
          "soft",
          "timeo=50",
          "retrans=3",
          "noatime"
        ],
        "networks": [
          "10.10.20.141",
          "10.10.20.142",
          "10.10.20.143",
          "10.10.20.100",
          "10.10.10.0/24"
        ]
      }
    }
  }
}
