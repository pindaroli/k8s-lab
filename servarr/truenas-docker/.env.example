# Servarr & Docker Stack Environment Template
# Copiare in .env e valorizzare i parametri sensibili

PUID=1000
PGID=1000
TZ=Europe/Rome

# Homepage MCP Security Token (minimo 32 caratteri)
HOMEPAGE_MCP_TOKEN=

# Notification / Mail Secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_RECIPIENT=
EMAIL_SENDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
